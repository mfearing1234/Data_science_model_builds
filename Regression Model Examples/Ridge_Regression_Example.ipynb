    "#Ridge regressions impose penaltys on the size of the coefficiencts. The ridge coefficients minimize a penalized residual sum of squares\n",
    "from sklearn import linear_model\n",
    "reg = linear_model.Ridge(alpha=.5)\n",
    "reg.fit([[0, 0], [0, 0], [1, 1]], [0, .1, 1])\n",
    "reg.coef_\n"
   ]
