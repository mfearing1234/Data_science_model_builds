# Copy this file to .env and fill in your free HuggingFace token
#
# Get your free token at: https://huggingface.co/settings/tokens
#   1. Create a free account at huggingface.co
#   2. Go to Settings → Access Tokens
#   3. Click "New token" → choose "Read" scope → copy it below

HF_TOKEN=your_hf_token_here

# Add .env to .gitignore to keep your token private:
# echo ".env" >> ../.gitignore
